# C# API adresi: bilgisayarının IP'si ve 5076 portu
# Mac'te: ipconfig getifaddr en0 · Windows'ta: ipconfig → "Wireless LAN adapter Wi-Fi" → IPv4 Address
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:5076
# GEÇİCİ (B2 gelene kadar): Giriş ekranı yokken gerçek uçları denemek için Swagger'daki kayıt ya da giriş
# cevabındaki accessToken. Yalnızca geliştirme modunda kullanılır. Gerçek anahtarı yalnızca .env.local'a yaz.
# EXPO_PUBLIC_DEV_TOKEN=
